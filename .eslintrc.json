{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "globals": {
    "util": "readonly",
    "ui": "readonly",
    "i18n": "readonly",
    "auth": "readonly",
    "statusModule": "readonly",
    "qrScanner": "readonly",
    "rateLimiter": "readonly",
    "hexMD5": "readonly",
    "hex_md5": "readonly",
    "doLogin": "readonly",
    "jsQR": "readonly",
    "Hotspot": "writable"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "vars": "all", "args": "none" }],
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-redeclare": "warn",
    "no-useless-escape": "warn"
  },
  "overrides": [
    {
      "files": ["src/js/**/*.js"],
      "env": {
        "es6": false,
        "es2021": false
      },
      "globals": {
        "Promise": "readonly"
      },
      "parserOptions": {
        "ecmaVersion": 5
      }
    }
  ]
}
