{
  "name": "mikrotik-hotspot-portal",
  "version": "2.8.3",
  "description": "Production-ready bilingual (AR/EN) MikroTik RouterOS v6/v7 captive portal & Meganet Hotspot Studio — QR card scanner (BarcodeDetector + jsQR contrast-stretch; bare, =/- prefix, [a-z] user+pass & link cards), WebView-resilient recent vouchers, white-label presets, and separate numbered Portal/Studio releases.",
  "main": "desktop/main.js",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "watch": "node build.js --watch",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=tests/modules",
    "test:e2e": "playwright test",
    "test:a11y": "jest --testPathPattern=tests/a11y",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/js/**/*.js\" \"admin/**/*.js\" \"scripts/**/*.js\" \"desktop/main.js\" build.js",
    "validate": "node scripts/validate-templates.js",
    "preview": "node scripts/preview.mjs",
    "preview:open": "node scripts/preview.mjs --open",
    "preview:error": "node scripts/preview.mjs --scenario error",
    "validate:config": "node scripts/validate-config.js",
    "admin": "node admin/server.js",
    "app:dev": "electron desktop/main.js",
    "app:build": "electron-builder --win",
    "app:build:numbered": "node scripts/build-studio.js",
    "portal:package": "node scripts/package-portal.js"
  },
  "keywords": [
    "mikrotik",
    "hotspot",
    "captive-portal",
    "routeros",
    "wifi"
  ],
  "author": "Mr-Muhamad <mrmuhamad@outlook.com> (https://github.com/Mr-Muhamad)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Muhamad/Meganet-hotspot-portal.git"
  },
  "license": "MIT",
  "dependencies": {
    "clean-css": "^4.2.4",
    "html-minifier": "^4.0.0",
    "nunjucks": "^3.2.4",
    "svgo": "^3.3.5",
    "uglify-js": "^3.19.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "axe-core": "^4.8.2",
    "chokidar": "^3.6.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
