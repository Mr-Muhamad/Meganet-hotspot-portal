{
  "name": "mikrotik-hotspot-portal",
  "version": "2.0.0",
  "description": "Modern MikroTik RouterOS hotspot portal templates with iOS CNA compatibility",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "watch": "node build.js --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/modules",
    "test:e2e": "playwright test",
    "test:a11y": "jest --testPathPattern=tests/a11y",
    "test:watch": "jest --watch",
    "lint": "eslint src/js/**/*.js",
    "validate": "node scripts/validate-templates.js",
    "preview": "node scripts/preview.mjs",
    "preview:open": "node scripts/preview.mjs --open",
    "preview:error": "node scripts/preview.mjs --scenario error",
    "validate:config": "node scripts/validate-config.js"
  },
  "keywords": [
    "mikrotik",
    "hotspot",
    "captive-portal",
    "routeros",
    "wifi"
  ],
  "author": "Mr-Muhamad <mrmuhamad@outlook.com> (https://github.com/Mr-Muhamad)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Muhamad/meganet-hotspot-portal.git"
  },
  "license": "MIT",
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "axe-core": "^4.8.2",
    "eslint": "^8.55.0",
    "html-minifier": "^4.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "svgo": "^3.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
